@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap");

/* Base & Typography */
html, body, [class*="css"] {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    color: #e4e4e7 !important;
}

.stApp {
    background-color: #09090b !important;
    background-image: radial-gradient(circle at 50% 0%, #18181b 0%, #09090b 70%) !important;
    min-height: 100vh !important;
    color: #e4e4e7 !important;
}

#MainMenu, footer {
    visibility: hidden;
    display: none !important;
}

/* Header spacing & fix cutoff */
header[data-testid="stHeader"] {
    background: transparent !important;
    visibility: visible !important;
    pointer-events: none !important;
    height: 2.5rem !important;
}

header[data-testid="stHeader"] * {
    pointer-events: auto !important;
}

/* Constrained Compact Container */
.block-container {
    max-width: 940px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-top: 2rem !important;
    padding-bottom: 4rem !important;
    padding-left: 1.5rem !important;
    padding-right: 1.5rem !important;
}

/* Hero Section - Monochrome Card */
.hero-section {
    background: #121214;
    border: 1px solid #27272a;
    border-radius: 16px;
    padding: 2rem 2.2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
}

.hero-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ffffff, transparent);
    opacity: 0.35;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 9999px;
    padding: 4px 12px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
}

.hero-title {
    font-size: 2.1rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    letter-spacing: -0.03em !important;
    line-height: 1.2 !important;
    margin: 0 0 0.5rem 0 !important;
}

.hero-subtitle {
    font-size: 0.92rem !important;
    color: #a1a1aa !important;
    margin: 0 0 1.25rem 0 !important;
    line-height: 1.5 !important;
}

.hero-stats {
    display: flex;
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid #27272a;
}

.hero-stat-value {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
}

.hero-stat-label {
    font-size: 0.68rem;
    color: #a1a1aa;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 2px;
}

/* Form Inputs - Black & White High Contrast */
textarea {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    border-radius: 12px !important;
    color: #ffffff !important;
    font-size: 0.95rem !important;
    padding: 0.9rem 1rem !important;
    transition: all 0.2s ease !important;
}

textarea:focus {
    border-color: #ffffff !important;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.2) !important;
    background: #18181b !important;
}

textarea::placeholder {
    color: #71717a !important;
}

/* Buttons */
.stButton > button {
    border-radius: 10px !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    padding: 0.55rem 1.2rem !important;
    transition: all 0.2s ease !important;
}

.stButton > button[kind="primary"] {
    background: #ffffff !important;
    border: 1px solid #ffffff !important;
    color: #000000 !important;
    box-shadow: 0 2px 10px rgba(255, 255, 255, 0.15) !important;
}

.stButton > button[kind="primary"]:hover {
    background: #e4e4e7 !important;
    border-color: #e4e4e7 !important;
    color: #000000 !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.25) !important;
}

.stButton > button[kind="secondary"] {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    color: #e4e4e7 !important;
}

.stButton > button[kind="secondary"]:hover {
    background: #18181b !important;
    border-color: #ffffff !important;
    color: #ffffff !important;
}

/* Sidebar */
[data-testid="stSidebar"] {
    background: #09090b !important;
    border-right: 1px solid #27272a !important;
}

[data-testid="stSidebar"] * {
    color: #d4d4d8 !important;
}

[data-testid="stSidebar"] h3 {
    color: #ffffff !important;
    font-weight: 700 !important;
}

.stSelectbox > div > div {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    border-radius: 8px !important;
    color: #ffffff !important;
}

/* Metrics */
[data-testid="metric-container"] {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    border-radius: 12px !important;
    padding: 0.8rem 1rem !important;
    transition: all 0.2s ease !important;
}

[data-testid="metric-container"]:hover {
    border-color: #3f3f46 !important;
    background: #18181b !important;
}

[data-testid="stMetricValue"] {
    color: #ffffff !important;
    font-weight: 700 !important;
    font-size: 1.5rem !important;
}

[data-testid="stMetricLabel"] {
    color: #a1a1aa !important;
    font-size: 0.72rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
}

/* Download Buttons */
[data-testid="stDownloadButton"] button {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    border-radius: 10px !important;
    color: #ffffff !important;
    width: 100% !important;
    font-weight: 600 !important;
    transition: all 0.2s ease !important;
}

[data-testid="stDownloadButton"] button:hover {
    background: #18181b !important;
    border-color: #ffffff !important;
    transform: translateY(-1px) !important;
}

/* Expanders */
.streamlit-expanderHeader {
    background: #121214 !important;
    border: 1px solid #27272a !important;
    border-radius: 10px !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    transition: all 0.2s ease !important;
}

.streamlit-expanderHeader:hover {
    border-color: #ffffff !important;
    background: #18181b !important;
}

.streamlit-expanderContent {
    border: 1px solid #27272a !important;
    border-top: none !important;
    border-radius: 0 0 10px 10px !important;
    background: #0d0d0f !important;
    color: #e4e4e7 !important;
}

/* Progress Bar Customization */
.stProgress > div > div > div > div {
    background-color: #ffffff !important;
    border-radius: 9999px !important;
}

.stProgress > div > div > div {
    background-color: #27272a !important;
    border-radius: 9999px !important;
    height: 8px !important;
}

/* Live Timer & Progress Card */
.progress-card {
    background: #121214;
    border: 1px solid #27272a;
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    margin: 1.2rem 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.progress-timer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
}

.progress-timer-title {
    font-weight: 700;
    color: #ffffff;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 8px;
}

.progress-timer-val {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.85rem;
    color: #ffffff;
    background: #18181b;
    border: 1px solid #3f3f46;
    padding: 3px 9px;
    border-radius: 6px;
}

.progress-stage-desc {
    font-size: 0.82rem;
    color: #a1a1aa;
    margin-top: 0.5rem;
}

/* Section Headers */
.section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 1.6rem 0 0.8rem;
}

.section-header-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
}

.section-header-line {
    flex: 1;
    height: 1px;
    background: #27272a;
}

/* Report Title Block */
.report-title-block {
    text-align: center;
    padding: 1.5rem 0 1rem;
}

.report-title-block h2 {
    font-size: 1.8rem !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    letter-spacing: -0.02em !important;
    margin-bottom: 0.4rem !important;
}

.report-title-block p {
    color: #a1a1aa !important;
    font-size: 0.85rem !important;
}

/* Finding Cards */
.finding-card {
    background: #121214;
    border: 1px solid #27272a;
    border-left: 3px solid #ffffff;
    border-radius: 0 10px 10px 0;
    padding: 0.85rem 1rem;
    margin-bottom: 0.6rem;
    transition: all 0.2s ease;
}

.finding-card:hover {
    background: #18181b;
    border-color: #3f3f46;
    border-left-color: #ffffff;
}

.finding-card.uncertain {
    border-left-color: #71717a;
}

.finding-claim {
    color: #f4f4f5;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 0.4rem;
}

.finding-citations {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.cite-badge {
    display: inline-block;
    background: #18181b;
    border: 1px solid #3f3f46;
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 0.68rem;
    font-weight: 600;
    color: #e4e4e7;
    text-decoration: none;
    transition: all 0.15s ease;
}

.cite-badge:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
}

/* References */
.ref-item {
    display: flex;
    gap: 10px;
    padding: 0.6rem 0;
    border-bottom: 1px solid #27272a;
    align-items: flex-start;
}

.ref-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: #000000;
    background: #ffffff;
    border-radius: 4px;
    padding: 1px 7px;
    white-space: nowrap;
    flex-shrink: 0;
    margin-top: 2px;
}

.ref-title {
    color: #f4f4f5;
    font-size: 0.85rem;
    font-weight: 500;
    margin: 0 0 2px;
}

.ref-url {
    color: #a1a1aa;
    font-size: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    text-decoration: none;
}

.ref-url:hover {
    color: #ffffff;
    text-decoration: underline;
}

/* Progress Stage Tracker Pills */
.progress-stage {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #121214;
    border: 1px solid #27272a;
    border-radius: 9999px;
    padding: 4px 11px;
    font-size: 0.72rem;
    font-weight: 500;
    color: #71717a;
    margin: 2px;
    transition: all 0.2s ease;
}

.progress-stage.done {
    background: #18181b;
    border-color: #52525b;
    color: #ffffff;
}

.progress-stage.active {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
    font-weight: 700;
}

/* Executive Summary Card */
.exec-summary {
    background: #121214;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 1.1rem 1.4rem;
    margin: 0.4rem 0 1.2rem;
}

.exec-summary p {
    color: #e4e4e7;
    font-size: 0.92rem;
    line-height: 1.7;
    margin: 0;
}

.divider {
    height: 1px;
    background: #27272a;
    margin: 1.5rem 0;
}

/* Alerts */
.stSuccess {
    background: #121214 !important;
    border-left: 3px solid #ffffff !important;
    color: #ffffff !important;
    border-radius: 8px !important;
}

.stInfo {
    background: #121214 !important;
    border-left: 3px solid #a1a1aa !important;
    color: #e4e4e7 !important;
    border-radius: 8px !important;
}

.stWarning {
    background: #121214 !important;
    border-left: 3px solid #d4d4d8 !important;
    color: #f4f4f5 !important;
    border-radius: 8px !important;
}

.stError {
    background: #18181b !important;
    border-left: 3px solid #ef4444 !important;
    color: #fca5a5 !important;
    border-radius: 8px !important;
}

/* Sidebar Toggle Controls */
[data-testid="stExpandSidebarButton"],
button[data-testid="stExpandSidebarButton"],
[data-testid="collapsedControl"],
[data-testid="stSidebarCollapsedControl"],
button[aria-label="Expand sidebar"],
button[aria-label="Open sidebar"] {
    visibility: visible !important;
    display: inline-flex !important;
    opacity: 1 !important;
    position: fixed !important;
    top: 10px !important;
    left: 10px !important;
    z-index: 999999 !important;
    background: #121214 !important;
    border: 1px solid #3f3f46 !important;
    border-radius: 8px !important;
    padding: 6px 10px !important;
    cursor: pointer !important;
    transition: all 0.2s ease !important;
}

[data-testid="stExpandSidebarButton"]:hover,
[data-testid="collapsedControl"]:hover,
button[aria-label="Expand sidebar"]:hover {
    background: #18181b !important;
    border-color: #ffffff !important;
}

[data-testid="stExpandSidebarButton"] *,
[data-testid="collapsedControl"] *,
button[aria-label="Expand sidebar"] * {
    color: #ffffff !important;
    fill: #ffffff !important;
    stroke: #ffffff !important;
}
