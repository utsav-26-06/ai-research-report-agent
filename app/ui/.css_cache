@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap");
html,body,[class*="css"]{font-family:"Inter",sans-serif}
.stApp{background:linear-gradient(135deg,#0a0a1a 0%,#0d1b2a 40%,#0f0f23 100%);min-height:100vh}
#MainMenu,footer,header{visibility:hidden}
.block-container{padding:0!important;max-width:100%!important}
.hero-section{background:linear-gradient(135deg,rgba(102,126,234,.15) 0%,rgba(118,75,162,.12) 50%,rgba(240,147,251,.08) 100%);border-bottom:1px solid rgba(255,255,255,.06);padding:3rem 4rem 2.5rem;position:relative;overflow:hidden}
.hero-section::before,.hero-section::after{content:"";position:absolute;border-radius:50%}
.hero-section::before{width:600px;height:600px;background:radial-gradient(circle,rgba(102,126,234,.12) 0%,transparent 70%);top:-200px;right:-100px;animation:float 8s ease-in-out infinite}
.hero-section::after{width:400px;height:400px;background:radial-gradient(circle,rgba(240,147,251,.08) 0%,transparent 70%);bottom:-150px;left:100px;animation:float 10s ease-in-out infinite reverse}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-20px)}}
.hero-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(102,126,234,.2);border:1px solid rgba(102,126,234,.4);border-radius:100px;padding:6px 16px;font-size:.75rem;font-weight:600;color:#a78bfa;letter-spacing:.05em;text-transform:uppercase;margin-bottom:1.2rem}
.hero-title{font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;background:linear-gradient(135deg,#fff 0%,#a78bfa 50%,#f0abfc 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1.15;margin:0 0 .8rem}
.hero-subtitle{font-size:1.05rem;color:rgba(255,255,255,.5);margin:0;max-width:560px}
.hero-stats{display:flex;gap:2.5rem;margin-top:2rem}
.hero-stat-value{font-size:1.3rem;font-weight:700;background:linear-gradient(135deg,#a78bfa,#f0abfc);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero-stat-label{font-size:.68rem;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.1em}
.main-container{padding:2.5rem 4rem;max-width:1100px;margin:0 auto}
textarea{background:rgba(255,255,255,.04)!important;border:1px solid rgba(255,255,255,.1)!important;border-radius:14px!important;color:rgba(255,255,255,.9)!important;font-size:1rem!important;padding:1rem!important;transition:border-color .2s,box-shadow .2s!important}
textarea:focus{border-color:rgba(167,139,250,.6)!important;box-shadow:0 0 0 3px rgba(167,139,250,.1)!important}
textarea::placeholder{color:rgba(255,255,255,.22)!important}
.stButton>button{border-radius:12px!important;font-weight:600!important;transition:all .2s ease!important}
.stButton>button[kind=primary]{background:linear-gradient(135deg,#667eea,#764ba2)!important;border:none!important;color:#fff!important;box-shadow:0 4px 20px rgba(102,126,234,.4)!important}
.stButton>button[kind=primary]:hover{transform:translateY(-2px)!important;box-shadow:0 8px 30px rgba(102,126,234,.55)!important}
.stButton>button[kind=secondary]{background:rgba(255,255,255,.05)!important;border:1px solid rgba(255,255,255,.12)!important;color:rgba(255,255,255,.65)!important}
.stButton>button[kind=secondary]:hover{background:rgba(255,255,255,.1)!important;color:#fff!important}
[data-testid=stSidebar]{background:rgba(8,8,20,.97)!important;border-right:1px solid rgba(255,255,255,.06)!important}
[data-testid=stSidebar] *{color:rgba(255,255,255,.7)!important}
[data-testid=stSidebar] h3{color:rgba(255,255,255,.9)!important;font-weight:700!important}
.stSelectbox>div>div{background:rgba(255,255,255,.04)!important;border:1px solid rgba(255,255,255,.1)!important;border-radius:10px!important;color:rgba(255,255,255,.8)!important}
[data-testid=metric-container]{background:rgba(255,255,255,.03)!important;border:1px solid rgba(255,255,255,.07)!important;border-radius:14px!important;padding:1rem 1.2rem!important;transition:all .2s ease!important}
[data-testid=metric-container]:hover{background:rgba(167,139,250,.06)!important;border-color:rgba(167,139,250,.25)!important}
[data-testid=stMetricValue]{color:#a78bfa!important;font-weight:700!important}
[data-testid=stMetricLabel]{color:rgba(255,255,255,.38)!important;font-size:.78rem!important}
[data-testid=stDownloadButton] button{background:rgba(255,255,255,.05)!important;border:1px solid rgba(255,255,255,.12)!important;border-radius:12px!important;color:rgba(255,255,255,.85)!important;width:100%!important;font-weight:500!important;transition:all .2s ease!important}
[data-testid=stDownloadButton] button:hover{background:rgba(167,139,250,.12)!important;border-color:rgba(167,139,250,.4)!important;color:#fff!important;transform:translateY(-1px)!important}
.streamlit-expanderHeader{background:rgba(255,255,255,.03)!important;border:1px solid rgba(255,255,255,.08)!important;border-radius:12px!important;color:rgba(255,255,255,.8)!important;font-weight:600!important;transition:all .2s ease!important}
.streamlit-expanderHeader:hover{background:rgba(167,139,250,.06)!important;border-color:rgba(167,139,250,.25)!important}
.streamlit-expanderContent{border:1px solid rgba(255,255,255,.05)!important;border-top:none!important;border-radius:0 0 12px 12px!important;background:rgba(0,0,0,.15)!important;color:rgba(255,255,255,.72)!important}
.stSuccess{background:rgba(74,222,128,.08)!important;border-left:3px solid #4ade80!important;border-radius:10px!important}
.stInfo{background:rgba(96,165,250,.08)!important;border-left:3px solid #60a5fa!important;border-radius:10px!important}
.stWarning{background:rgba(251,191,36,.08)!important;border-left:3px solid #fbbf24!important;border-radius:10px!important}
.stError{background:rgba(248,113,113,.08)!important;border-left:3px solid #f87171!important;border-radius:10px!important}
.section-header{display:flex;align-items:center;gap:14px;margin:2rem 0 1rem}
.section-header-text{font-size:.72rem;font-weight:700;color:#a78bfa;text-transform:uppercase;letter-spacing:.12em;white-space:nowrap}
.section-header-line{flex:1;height:1px;background:linear-gradient(90deg,rgba(167,139,250,.3),transparent)}
.report-title-block{text-align:center;padding:2rem 0 1rem}
.report-title-block h2{font-size:1.9rem;font-weight:800;background:linear-gradient(135deg,#fff,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.report-title-block p{color:rgba(255,255,255,.38);font-size:.88rem}
.finding-card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);border-left:3px solid #a78bfa;border-radius:0 12px 12px 0;padding:.9rem 1.1rem;margin-bottom:.7rem;transition:all .2s ease}
.finding-card:hover{background:rgba(167,139,250,.05);border-left-color:#f0abfc;transform:translateX(3px)}
.finding-card.uncertain{border-left-color:#fbbf24}
.finding-claim{color:rgba(255,255,255,.85);font-size:.93rem;line-height:1.65;margin:0 0 .5rem}
.finding-citations{display:flex;flex-wrap:wrap;gap:6px}
.cite-badge{display:inline-block;background:rgba(102,126,234,.18);border:1px solid rgba(102,126,234,.32);border-radius:6px;padding:2px 8px;font-size:.7rem;font-weight:600;color:#818cf8;text-decoration:none;transition:all .15s ease}
.cite-badge:hover{background:rgba(102,126,234,.35);color:#fff}
.ref-item{display:flex;gap:12px;padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.05);align-items:flex-start}
.ref-num{font-size:.72rem;font-weight:600;color:#a78bfa;background:rgba(167,139,250,.12);border-radius:6px;padding:2px 8px;white-space:nowrap;flex-shrink:0;margin-top:2px}
.ref-title{color:rgba(255,255,255,.8);font-size:.87rem;font-weight:500;margin:0 0 2px}
.ref-url{color:rgba(102,126,234,.75);font-size:.76rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;text-decoration:none}
.ref-url:hover{color:#a78bfa}
.progress-stage{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:100px;padding:5px 13px;font-size:.73rem;font-weight:500;color:rgba(255,255,255,.38);transition:all .3s ease;margin:3px}
.progress-stage.done{background:rgba(74,222,128,.1);border-color:rgba(74,222,128,.3);color:#4ade80}
.progress-stage.active{background:rgba(167,139,250,.15);border-color:rgba(167,139,250,.5);color:#a78bfa;animation:pulse-stage 1.5s ease-in-out infinite}
@keyframes pulse-stage{0%,100%{box-shadow:0 0 0 0 rgba(167,139,250,.4)}50%{box-shadow:0 0 0 8px rgba(167,139,250,0)}}
.exec-summary{background:linear-gradient(135deg,rgba(102,126,234,.1),rgba(118,75,162,.07));border:1px solid rgba(102,126,234,.2);border-radius:16px;padding:1.3rem 1.7rem;margin:.5rem 0 1.5rem}
.exec-summary p{color:rgba(255,255,255,.75);font-size:.93rem;line-height:1.75;margin:0}
.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent);margin:2rem 0}
