# =============================================================
# Research & Report Agent — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================
#
# HOW TO GET YOUR FREE API KEYS:
#
#   GEMINI_API_KEY:
#     1. Go to https://aistudio.google.com
#     2. Sign in with your Google account
#     3. Click "Get API Key" -> "Create API key"
#     Key starts with: AIza...
#
#   TAVILY_API_KEY:
#     1. Go to https://tavily.com
#     2. Sign up free (no credit card)
#     3. Dashboard -> copy your key
#     Key starts with: tvly-...
#
# =============================================================

# --- Google Gemini (LLM + Embeddings) ---
GEMINI_API_KEY=AIza...your-key-here...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# --- Tavily Search (Free: 1000 searches/month) ---
TAVILY_API_KEY=tvly-...your-key-here...
TAVILY_MAX_RESULTS=5
TAVILY_SEARCH_DEPTH=basic

# --- RAG / ChromaDB (runs locally, fully free) ---
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=research_agent

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Source Evaluation ---
MIN_RELEVANCE_SCORE=0.5
MIN_CREDIBILITY_SCORE=0.4
MAX_SOURCES_PER_QUERY=5

# --- Output ---
OUTPUT_DIR=./outputs

# --- Logging ---
LOG_LEVEL=INFO
